{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "versions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
          },
          "download": {
            "type": "string",
            "format": "uri"
          },
          "sha512": {
            "type": "string",
            "pattern": "^[0-9a-f]{128}$"
          },
          "released": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "changelog": {
            "type": "string",
            "format": "uri"
          },
          "revoked": {
            "anyOf": [
              {
                "type": "boolean",
                "const": true
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        },
        "required": [
          "version",
          "download",
          "sha512"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "versions"
  ],
  "additionalProperties": false
}
